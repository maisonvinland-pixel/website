{%- comment -%}
  Alo Doudou : ce snippet est rendu avant les icônes du header.
  Le sprite ci-dessous redéfinit donc les icônes (premier id trouvé = utilisé).
{%- endcomment -%}
<link rel='preconnect' href='https://fonts.googleapis.com'>
<link rel='preconnect' href='https://fonts.gstatic.com' crossorigin>
<link rel='stylesheet' href='https://fonts.googleapis.com/css2?family=Righteous&display=swap'>
{{ 'alo-doudou.css' | asset_url | stylesheet_tag }}
{{ 'alo-palette.css' | asset_url | stylesheet_tag }}
<svg aria-hidden='true' focusable='false' style='position:absolute;width:0;height:0;overflow:hidden'>
  <symbol id='icon-search' viewBox='0 0 24 24'>
    <g fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>
      <circle cx='10.5' cy='10.5' r='7'/>
      <path d='M15.8 15.8 21 21'/>
      <path d='M7 11.2q1.75-1.7 3.5 0t3.5 0'/>
    </g>
  </symbol>
  <symbol id='icon-account' viewBox='0 0 24 24'>
    <g fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>
      <circle cx='12' cy='8.5' r='4.2'/>
      <path d='M10.4 9.6q1.6 1.3 3.2 0'/>
      <path d='M4 21c1.1-4 4.3-6.2 8-6.2s6.9 2.2 8 6.2'/>
    </g>
  </symbol>
  <symbol id='icon-bag' viewBox='0 0 24 24'>
    <g fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>
      <path d='M4.6 8h14.8l-1.2 11.4a2 2 0 0 1-2 1.8H7.8a2 2 0 0 1-2-1.8Z'/>
      <path d='M8.8 10.5V7a3.2 3.2 0 0 1 6.4 0v3.5'/>
      <path d='M6.6 15q1.35-1.4 2.7 0t2.7 0t2.7 0t2.7 0'/>
    </g>
  </symbol>
  <symbol id='icon-wishlist-header' viewBox='0 0 24 24'>
    <g fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>
      <path d='M12 20.5s-7.5-4.6-7.5-10.4A4.2 4.2 0 0 1 12 7.4a4.2 4.2 0 0 1 7.5 2.7c0 5.8-7.5 10.4-7.5 10.4Z'/>
    </g>
  </symbol>
  <symbol id='icon-recently-view' viewBox='0 0 24 24'>
    <g fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>
      <circle cx='12' cy='12' r='9'/>
      <path d='M12 7v5l3 2'/>
    </g>
  </symbol>
  <symbol id='alo-icon-ticket' viewBox='0 0 24 24'>
    <g fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>
      <path d='M3.5 6.5h17v3.2a2.3 2.3 0 0 0 0 4.6v3.2h-17v-3.2a2.3 2.3 0 0 0 0-4.6Z'/>
      <path d='m9.5 14.5 5-5'/>
      <circle cx='9.8' cy='9.8' r='.6' fill='currentColor'/>
      <circle cx='14.2' cy='14.2' r='.6' fill='currentColor'/>
    </g>
  </symbol>
  <symbol id='alo-icon-truck' viewBox='0 0 24 24'>
    <g fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'>
      <path d='M2.5 6.5h11v9.5h-11z'/>
      <path d='M13.5 9.5h4l3 3.2V16h-7'/>
      <circle cx='7' cy='17.5' r='1.8' fill='#fff'/>
      <circle cx='17' cy='17.5' r='1.8' fill='#fff'/>
      <path d='M4.5 11.5q1-1 2 0t2 0t2 0'/>
    </g>
  </symbol>
  <symbol id='alo-icon-return' viewBox='0 0 24 24'>
    <g fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'>
      <path d='M4 10h10.5a5 5 0 0 1 0 10H9'/>
      <path d='M8 6 4 10l4 4'/>
    </g>
  </symbol>
  <symbol id='alo-icon-lock' viewBox='0 0 24 24'>
    <g fill='none' stroke='currentColor' stroke-width='1.7' stroke-linecap='round' stroke-linejoin='round'>
      <rect x='5' y='10.5' width='14' height='10' rx='2.5'/>
      <path d='M8.2 10.5V8a3.8 3.8 0 0 1 7.6 0v2.5'/>
      <path d='M12 14.6v2'/>
    </g>
  </symbol>
</svg>
<div
  data-action='toggle-nav'
  class='action nav-toggle overlay inline-flex pointer w-44 h-44 hidden-1025 header-color align-center{% if settings.rtl %} justify-content-start{% endif %}'
  aria-label='Menu'
>
  <svg width='24' height='18' viewBox='0 0 24 18' fill='none' stroke='currentColor' stroke-width='1.9' stroke-linecap='round'>
    <path d='M2 3q2.5-2 5 0t5 0t5 0t5 0'/>
    <path class='alo-burger-mid' d='M2 9q2.5 0 5 0t5 0t5 0t5 0'/>
    <path d='M2 15q2.5-2 5 0t5 0t5 0t5 0'/>
  </svg>
</div>
