{%- comment -%}
  Alo Doudou : moyens de paiement réellement activés dans la boutique.
{%- endcomment -%}
{%- if shop.enabled_payment_types.size > 0 -%}
  {{ 'alo-sections.css' | asset_url | stylesheet_tag }}
  <div class="alo-payicons" {{ block.shopify_attributes }}>
    {%- if block.settings.heading != blank -%}
      <p class="alo-payicons__title">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="10.5" width="14" height="10" rx="2.5"/><path d="M8.2 10.5V8a3.8 3.8 0 0 1 7.6 0v2.5"/></svg>
        {{ block.settings.heading }}
      </p>
    {%- endif -%}
    <ul class="alo-payicons__list" role="list">
      {%- for type in shop.enabled_payment_types -%}
        <li class="alo-payicons__item">{{ type | payment_type_svg_tag }}</li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}
