{%- comment -%}
  Alo Doudou : FAQ « centre d'aide » avec recherche instantanée,
  catégories, accordéons animés et données structurées FAQPage (SEO).
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign cats = ''
  assign clist = ''
  for block in section.blocks
    assign c = block.settings.category | strip
    if c != blank
      assign key = '|' | append: c | append: '|'
      unless cats contains key
        assign cats = cats | append: key
        assign clist = clist | append: '§' | append: c
      endunless
    endif
  endfor
  assign cat_list = clist | remove_first: '§' | split: '§'
-%}
{{ 'alo-boutique.css' | asset_url | stylesheet_tag }}
<script src="{{ 'alo-boutique.js' | asset_url }}" defer="defer"></script>

<section
  class="alo-faq"
  data-alo-faq
  style="--alo-pt: {{ st.padding_top }}px; --alo-pb: {{ st.padding_bottom }}px;"
>
  <div class="alo-faq__wrap">
    <aside class="alo-faq__intro">
      <div class="alo-faq__card">
        <span class="alo-faq__glow" aria-hidden="true"></span>
        {%- if st.kicker != blank -%}<p class="alo-faq__kicker">{{ st.kicker }}</p>{%- endif -%}
        <h2 class="alo-faq__title">{{ st.heading }}</h2>
        {%- if st.text != blank -%}<div class="alo-faq__text">{{ st.text }}</div>{%- endif -%}
        <label class="alo-faq__search">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <span class="visually-hidden">{{ 'alo.faq.search_label' | t }}</span>
          <input type="search" placeholder="{{ st.search_placeholder | escape }}" data-alo-faq-search autocomplete="off">
        </label>
        {%- if st.contact_label != blank -%}
          <div class="alo-faq__contact">
            <p>{{ st.contact_text }}</p>
            <a class="alo-faq__cta" href="{{ st.contact_link | default: '/pages/contact' }}">
              {{ st.contact_label }}
              <svg width="16" height="12" viewBox="0 0 16 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 6h13M9.5 1.5 14 6l-4.5 4.5"/></svg>
            </a>
          </div>
        {%- endif -%}
      </div>
    </aside>

    <div class="alo-faq__main">
      {%- if cat_list.size > 1 -%}
        <div class="alo-faq__tabs" role="tablist" aria-label="{{ 'alo.faq.categories_label' | t }}">
          <button type="button" class="alo-faq__tab is-active" data-alo-faq-tab="*" role="tab" aria-selected="true">{{ 'alo.faq.all' | t }}</button>
          {%- for c in cat_list -%}
            <button type="button" class="alo-faq__tab" data-alo-faq-tab="{{ c | handleize }}" role="tab" aria-selected="false">{{ c }}</button>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="alo-faq__list">
        {%- for block in section.blocks -%}
          {%- assign n = forloop.index -%}
          <details
            class="alo-faq__item"
            data-alo-faq-item
            data-cat="{{ block.settings.category | strip | handleize }}"
            {% if forloop.first and st.open_first %}open{% endif %}
            {{ block.shopify_attributes }}
          >
            <summary class="alo-faq__q">
              <span class="alo-faq__num">{% if n < 10 %}0{% endif %}{{ n }}</span>
              <span class="alo-faq__qtext">{{ block.settings.question }}</span>
              <span class="alo-faq__icon" aria-hidden="true"></span>
            </summary>
            <div class="alo-faq__a">
              <div class="alo-faq__a-inner">{{ block.settings.answer }}</div>
            </div>
          </details>
        {%- endfor -%}
        <p class="alo-faq__empty" data-alo-faq-empty hidden>
          {%- assign contact_url = st.contact_link | default: '/pages/contact' -%}
          {{ 'alo.faq.empty_html' | t: url: contact_url }}
        </p>
      </div>
    </div>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | strip_html | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ centre d'aide",
  "tag": "div",
  "class": "section-alo-faq",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Petit titre",
      "default": "Centre d'aide"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Tes questions, nos réponses"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Tout ce qu'il faut savoir avant de commander. Tape un mot-clé pour trouver ta réponse en un instant.</p>"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Texte de la barre de recherche",
      "default": "Livraison, taille, retour…"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Ouvrir la première question",
      "default": true
    },
    {
      "type": "header",
      "content": "Contact"
    },
    {
      "type": "text",
      "id": "contact_text",
      "label": "Texte",
      "default": "Tu ne trouves pas ta réponse ? Une vraie personne te répond."
    },
    {
      "type": "text",
      "id": "contact_label",
      "label": "Texte du bouton",
      "default": "Écris-nous"
    },
    {
      "type": "url",
      "id": "contact_link",
      "label": "Lien du bouton"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge du haut",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge du bas",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "category",
          "label": "Catégorie",
          "info": "Les questions avec la même catégorie sont regroupées sous un même onglet.",
          "default": "Commande"
        },
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "Ta question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Réponse",
          "default": "<p>Ta réponse.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ centre d'aide"
    }
  ]
}
{% endschema %}
