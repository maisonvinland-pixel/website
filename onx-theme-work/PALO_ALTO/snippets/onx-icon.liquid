    {%- when 'mail' -%}<rect x="3.5" y="5.5" width="17" height="13" rx="2"/><path d="M4 7l8 6 8-6"/>
    {%- when 'arrow-right' -%}<path d="M4.5 12h15M13.5 6l6 6-6 6"/>
