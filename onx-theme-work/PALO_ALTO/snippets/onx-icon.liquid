{%- comment -%}
  ONX — jeu d'icônes linéaires (24px, trait 1.75, currentColor).
  Usage : {% render 'onx-icon', icon: 'truck', size: 20 %}
  Icônes : check, check-circle, truck, lock, return, chat, star, gift, shield, bolt, leaf,
  clock, tag, box, heart, award, globe, phone, mail, arrow-right, play, pause, volume,
  mute, plus, minus, close, sparkle, ruler, smile, card, users, cart, copy,
  snowflake, thermometer, mountain, wind, drop (icônes de réassurance — jamais en logo)
{%- endcomment -%}
{%- assign s = size | default: 24 -%}
{%- capture p -%}
  {%- case icon -%}
    {%- when 'check' -%}<path d="M5 12.5l4.5 4.5L19 7.5"/>
    {%- when 'check-circle' -%}<circle cx="12" cy="12" r="9"/><path d="M8 12.3l2.7 2.7L16.2 9.5"/>
