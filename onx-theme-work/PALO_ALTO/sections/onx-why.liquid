{%- comment -%}
  ONX — « Pourquoi ONX ? » : raisons de choisir la marque + tableau comparatif optionnel.
  Comparez uniquement des éléments vérifiables. Ne citez pas de concurrent nommé.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign dm = request.design_mode
  assign eyebrow = s.eyebrow
  assign title = s.title
  assign intro = s.intro
  if dm == false
    if eyebrow contains '['
      assign eyebrow = ''
    endif
    if title contains '['
      assign title = ''
    endif
    if intro contains '['
      assign intro = ''
    endif
  endif
  assign reasons_count = 0
  assign rows_count = 0
-%}
{%- capture reasons -%}
  {%- for block in section.blocks -%}
    {%- if block.type != 'reason' -%}{%- continue -%}{%- endif -%}
    {%- liquid
      assign t = block.settings.title
      assign d = block.settings.text
      if dm == false
        if t contains '['
          continue
        endif
        if d contains '['
          assign d = ''
        endif
      endif
      if t == blank
        continue
      endif
      assign reasons_count = reasons_count | plus: 1
    -%}
    <div class="onx-why__reason" {{ block.shopify_attributes }}>
      <span class="onx-why__num">{{ reasons_count | prepend: '0' | slice: -2, 2 }}</span>
      <div>
        <h3 class="onx-why__reason-title">{% render 'onx-icon', icon: block.settings.icon, size: 20 %}<span>{% render 'onx-text', text: t %}</span></h3>
        {%- if d != blank -%}<p class="onx-why__reason-text">{% render 'onx-text', text: d %}</p>{%- endif -%}
      </div>
    </div>
  {%- endfor -%}
{%- endcapture -%}
{%- capture rows -%}
  {%- for block in section.blocks -%}
    {%- if block.type != 'row' -%}{%- continue -%}{%- endif -%}
    {%- liquid
      assign f = block.settings.feature
      if dm == false and f contains '['
        continue
      endif
      if f == blank
        continue
      endif
      assign rows_count = rows_count | plus: 1
    -%}
    <tr {{ block.shopify_attributes }}>
      <th scope="row">{% render 'onx-text', text: f %}</th>
      <td class="onx-why__us">{% if block.settings.us %}<span class="onx-why__yes" aria-label="{{ 'general.onx.yes' | t }}">{% render 'onx-icon', icon: 'check', size: 18 %}</span>{% else %}<span class="onx-why__no" aria-label="{{ 'general.onx.no' | t }}">—</span>{% endif %}</td>
      <td>{% if block.settings.them %}<span class="onx-why__yes onx-why__yes--muted" aria-label="{{ 'general.onx.yes' | t }}">{% render 'onx-icon', icon: 'check', size: 18 %}</span>{% else %}<span class="onx-why__no" aria-label="{{ 'general.onx.no' | t }}">{% render 'onx-icon', icon: 'close', size: 16 %}</span>{% endif %}</td>
    </tr>
  {%- endfor -%}
{%- endcapture -%}

{%- if reasons_count > 0 or rows_count > 0 or dm -%}
<section class="onx-why onx-section onx-scheme--{{ s.scheme }}" data-onx-section="why">
  <div class="onx-container">
    <div class="onx-section__head onx-section__head--center">
      {%- if eyebrow != blank -%}<p class="onx-eyebrow">{% render 'onx-text', text: eyebrow %}</p>{%- endif -%}
      {%- if title != blank -%}<h2 class="onx-h2">{% render 'onx-text', text: title %}</h2>{%- endif -%}
      {%- if intro != blank -%}<p class="onx-lead onx-muted">{% render 'onx-text', text: intro %}</p>{%- endif -%}
    </div>
    <div class="onx-why__layout{% if rows_count > 0 and reasons_count > 0 %} onx-why__layout--split{% endif %}">
      {%- if reasons_count > 0 -%}<div class="onx-why__reasons">{{ reasons }}</div>{%- endif -%}
      {%- if rows_count > 0 -%}
        <div class="onx-why__table-wrap">
          <table class="onx-why__table">
            <thead>
              <tr>
                <th scope="col"><span class="visually-hidden">{{ 'general.onx.feature' | t }}</span></th>
                <th scope="col" class="onx-why__us">{% render 'onx-wordmark', size: 'table' %}</th>
                <th scope="col">{{ s.them_label | escape }}</th>
              </tr>
            </thead>
            <tbody>{{ rows }}</tbody>
          </table>
        </div>
      {%- endif -%}
    </div>
    {%- if s.cta_label != blank -%}
      <div class="onx-section__foot onx-section__foot--center"><a class="onx-btn onx-btn--signal onx-btn--lg" href="{{ s.cta_link | default: routes.all_products_collection_url }}">{{ s.cta_label | escape }}{% render 'onx-icon', icon: 'arrow-right', size: 18 %}</a></div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

