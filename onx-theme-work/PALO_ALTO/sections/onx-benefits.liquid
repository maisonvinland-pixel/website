{%- comment -%}
  ONX — Bénéfices. Méthode : caractéristique → bénéfice → résultat.
  Utilisable sur la homepage et la page produit (textes compatibles sources dynamiques / métadonnées).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign dm = request.design_mode
  assign eyebrow = s.eyebrow
  assign title = s.title
  assign intro = s.intro
  if dm == false
    if eyebrow contains '['
      assign eyebrow = ''
    endif
    if title contains '['
      assign title = ''
    endif
    if intro contains '['
      assign intro = ''
    endif
  endif
  assign shown = 0
-%}
{%- capture cards -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign t = block.settings.title
      assign d = block.settings.text
      assign r = block.settings.result
      if dm == false
        if t contains '['
          continue
        endif
        if d contains '['
          assign d = ''
        endif
        if r contains '['
          assign r = ''
        endif
      endif
      if t == blank
        continue
      endif
      assign shown = shown | plus: 1
    -%}
    <article class="onx-benefit" {{ block.shopify_attributes }}>
      {%- if block.settings.image != blank -%}
        <div class="onx-benefit__media">
          {{ block.settings.image | image_url: width: 800 | image_tag: widths: '300, 500, 800', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', class: 'onx-cover' }}
        </div>
      {%- else -%}
        <span class="onx-benefit__icon">{% render 'onx-icon', icon: block.settings.icon, size: 26 %}</span>
      {%- endif -%}
      <h3 class="onx-benefit__title">{% render 'onx-text', text: t %}</h3>
      {%- if d != blank -%}<p class="onx-benefit__text">{% render 'onx-text', text: d %}</p>{%- endif -%}
      {%- if r != blank -%}<p class="onx-benefit__result">{% render 'onx-icon', icon: 'arrow-right', size: 14 %}<span>{% render 'onx-text', text: r %}</span></p>{%- endif -%}
    </article>
  {%- endfor -%}
{%- endcapture -%}

{%- if shown > 0 or dm -%}
<section class="onx-benefits onx-section onx-scheme--{{ s.scheme }}" data-onx-section="benefits">
  <div class="onx-container">
    <div class="onx-section__head{% if s.center %} onx-section__head--center{% endif %}">
      {%- if eyebrow != blank -%}<p class="onx-eyebrow">{% render 'onx-text', text: eyebrow %}</p>{%- endif -%}
      {%- if title != blank -%}<h2 class="onx-h2">{% render 'onx-text', text: title %}</h2>{%- endif -%}
      {%- if intro != blank -%}<p class="onx-lead onx-muted">{% render 'onx-text', text: intro %}</p>{%- endif -%}
    </div>
    <div class="onx-benefits__grid onx-benefits__grid--{{ shown }}">{{ cards }}</div>
    {%- if s.cta_label != blank -%}
      <div class="onx-section__foot"><a class="onx-btn onx-btn--primary" href="{{ s.cta_link | default: routes.all_products_collection_url }}">{{ s.cta_label | escape }}{% render 'onx-icon', icon: 'arrow-right', size: 18 %}</a></div>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

