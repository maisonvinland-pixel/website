{%- comment -%} ONX — USP / réassurance immédiate (3 à 4 éléments). {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign dm = request.design_mode
  assign count = 0
-%}
{%- capture items -%}
  {%- for block in section.blocks -%}
    {%- liquid
      assign t = block.settings.title
      assign d = block.settings.text
      if dm == false
        if t contains '['
          assign t = ''
        endif
        if d contains '['
          assign d = ''
        endif
      endif
    -%}
    {%- if t != blank -%}
      {%- assign count = count | plus: 1 -%}
      <li class="onx-usp__item" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}<a class="onx-usp__link" href="{{ block.settings.link }}">{%- endif -%}
        <span class="onx-usp__icon">{% render 'onx-icon', icon: block.settings.icon, size: 22 %}</span>
        <span class="onx-usp__text">
          <strong class="onx-usp__title">{% render 'onx-text', text: t %}</strong>
          {%- if d != blank -%}<span class="onx-usp__desc">{% render 'onx-text', text: d %}</span>{%- endif -%}
        </span>
        {%- if block.settings.link != blank -%}</a>{%- endif -%}
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if count > 0 -%}
  <section class="onx-usp onx-scheme--{{ s.scheme }}{% if s.compact %} onx-usp--compact{% endif %}" data-onx-section="usp">
    <div class="onx-container">
      <ul class="onx-usp__list onx-usp__list--{{ count }}" role="list">{{ items }}</ul>
    </div>
  </section>
{%- endif -%}

